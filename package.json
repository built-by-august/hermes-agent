{
  "name": "hermes-agent-web",
  "version": "0.1.0",
  "private": true,
  "description": "Custom Hermes Agent webapp monorepo: deploy -> map -> audit -> suggest -> implement -> wire -> verify -> handoff.",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3"
  }
}
