# syntax=docker/dockerfile:1
# Multi-stage build for the Custom Hermes Agent webapp (apps/web).
# React 18 + Vite, served as static assets by a slim nginx image with SPA
# history fallback and a /api reverse proxy to the API service.
#
# Build-time env (baked into the bundle):
#   VITE_API_MODE=http   -> use the real backend (required for production)
#   VITE_API_URL=/api/v1 -> base path the browser calls; nginx proxies it
#
# Build:  docker build -f Dockerfile.web -t custom-hermes-web .

FROM node:22-alpine AS base
ENV PNPM_HOME=/usr/local/bin
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/eslint-config/package.json packages/eslint-config/package.json
COPY apps/web/package.json apps/web/package.json
RUN --mount=type=cache,id=pnpm,target=/usr/local/share/pnpm-store \
    pnpm install --frozen-lockfile

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# VITE_API_MODE=http is mandatory here: the default is "mock" (in-memory, no backend).
ARG VITE_API_MODE=http
ARG VITE_API_URL=/api/v1
ENV VITE_API_MODE=$VITE_API_MODE
ENV VITE_API_URL=$VITE_API_URL
RUN pnpm --filter @repo/contracts build \
 && pnpm --filter @repo/web build

# ---- nginx runtime ----
FROM nginx:1.27-alpine AS runner
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/nginx-entrypoint.sh /docker-entrypoint.d/40-hermes-env.sh
RUN chmod +x /docker-entrypoint.d/40-hermes-env.sh
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
# nginx:alpine already runs /docker-entrypoint.d/*.sh then execs nginx.
# Our script substitutes ${API_UPSTREAM} before nginx starts.
