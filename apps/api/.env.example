# Copy to .env and adjust. This file is committed; .env is not.
# Backend (apps/api) — Prisma CLI loads this automatically from apps/api/.env
DATABASE_URL="file:./dev.db"
# JWT signing secret — set a strong value outside local dev
JWT_SECRET="dev-only-secret-change-me-in-production"
PORT=4000
HOST=0.0.0.0
