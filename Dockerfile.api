# syntax=docker/dockerfile:1
# Multi-stage build for the Custom Hermes Agent API (apps/api).
# Fastify 5 + Prisma. Targets a Postgres (or SQLite) database via DATABASE_URL.
#
# Build:  docker build -f Dockerfile.api -t custom-hermes-api .
# Run:    docker run --rm -p 4000:4000 \
#           -e DATABASE_URL=postgresql://user:pass@db:5432/hermes \
#           -e JWT_SECRET=... -e PORT=4000 \
#           custom-hermes-api

FROM node:22-alpine AS base
ENV PNPM_HOME=/usr/local/bin
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /app

# ---- deps ----
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/skills/package.json packages/skills/package.json
COPY packages/eslint-config/package.json packages/eslint-config/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
RUN --mount=type=cache,id=pnpm,target=/usr/local/share/pnpm-store \
    pnpm install --frozen-lockfile

# ---- builder ----
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Build shared packages and the api; generate the Prisma client.
RUN pnpm --filter @repo/contracts --filter @repo/skills --filter @repo/api build \
 && pnpm --filter @repo/api exec prisma generate

# ---- runner ----
FROM base AS runner
ENV NODE_ENV=production
WORKDIR /app/apps/api

# pnpm splits deps across layers: the shared workspace store + .pnpm virtual
# store live at /app/node_modules, while each package keeps its own
# node_modules with bin shims (e.g. .bin/prisma) and workspace-* symlinks into
# that store. We copy node_modules from the BUILDER (not deps): the builder ran
# `prisma generate`, so @prisma/client is a real client there, whereas in the
# deps stage its postinstall generated a placeholder. No pnpm CLI is used at
# runtime (it would want package.json + lockfile in the runner), so we invoke
# the prisma bin + compiled JS directly. @repo/contracts, @repo/skills resolve
# through the api-local node_modules into the shared .pnpm store.
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/apps/api/node_modules ./node_modules
# packages must land at /app/packages (not ./packages): the api-local
# node_modules symlinks (@repo/contracts -> ../../../../packages/contracts)
# resolve relative to the repo root, not to apps/api.
COPY --from=builder /app/packages /app/packages
COPY --from=builder /app/apps/api/dist ./dist
COPY --from=builder /app/apps/api/prisma ./prisma

EXPOSE 4000
# Apply migrations, seed the demo org once, then start the API.
CMD ["sh", "-c", "./node_modules/.bin/prisma migrate deploy --schema=prisma/schema.prisma && node dist/seed.js && node dist/server.js"]
